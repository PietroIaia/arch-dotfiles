;; Network/WiFi Widget
;; Displays WiFi status in the bar and provides a popup with connection details

;; Main WiFi button widget that appears in the settings bar
(defwidget wifi_button [monitor]
  (button
    :class "widget network"
    :onclick "~/.config/eww/scripts/toggle-popup.sh network-popup ${monitor}"
    (box
      :orientation "h"
      :space-evenly false
      (label 
        :text "${wifi_enabled == 'enabled' ?
          wifi_connected == 'yes' ?
          wifi_strength >= 75 ? '󰤨' :
          wifi_strength >= 50 ? '󰤥' :
          wifi_strength >= 25 ? '󰤢' : '󰤟'
        :
          '󰤯'
        : 
          '󰤭'
        }"
      )
      (label
        :class "network-title"
        :text "${wifi_ssid}"
      )
    )
  )
)

;; Popup widget with network details and controls
(defwidget network_popup []
  (box
    :class "network-popup"
    :orientation "v"
    :space-evenly false
    (box
      :orientation "h"
      :space-evenly false
      (box
        :class "network-current"
        :orientation "h"
        :space-evenly false
        :hexpand true
        :visible "${wifi_enabled == 'enabled'}"
        (label
          :class "network-current-name"
          :text "${wifi_ssid}"
          :halign "start"
          :hexpand true
        )
        (label
          :class "network-current-strength"
          :text "${wifi_strength}%"
          :halign "end"
        )
      )
      (button
        :class "network-toggle ${wifi_enabled == 'enabled' ? 'enabled' : 'disabled'}"
        :onclick "nmcli radio wifi ${wifi_enabled == 'enabled' ? 'off' : 'on'}"
        :halign "end"
        (label :text "${wifi_enabled == 'enabled' ? '●' : '○'}")
      )
    )

    ;; Separator
    (box
      :class "network-separator"
      :visible "${wifi_enabled == 'enabled'}"
    )

    ;; Available networks list
    (box
      :class "network-list"
      :orientation "v"
      :space-evenly false
      :visible "${wifi_enabled == 'enabled'}"

      (label
        :class "network-list-label"
        :text "Available Networks"
        :halign "start"
      )

      (scroll
        :vscroll true
        :hscroll false
        :height 200
        (literal :content wifi_networks)
      )
    )

    ;; Disconnected message
    (label
      :class "network-disabled-msg"
      :text "${wifi_enabled == 'disabled' ? 'WiFi is disabled' : 'Not connected'}"
      :visible "${wifi_enabled == 'disabled' || wifi_connected == 'no'}"
    )
  )
)

;; Popup window definition
(defwindow network-popup
  :geometry (geometry
    :x "5px"
    :y "5px"
    :width "300px"
    :anchor "top right"
  )
  :stacking "overlay"
  :exclusive false
  :focusable false
  (network_popup)
)
