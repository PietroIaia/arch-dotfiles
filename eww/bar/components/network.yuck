;; Network/WiFi Widget
;; Displays WiFi status in the bar and provides a popup with connection details

;; Main WiFi button widget that appears in the settings bar
(defwidget wifi_button [monitor]
  (button
    :class "widget network ${popup_open == 'network-window' ? 'active' : ''}"
    :onclick "~/.config/eww/scripts/toggle-popup.sh network-window ${monitor}"
    (box
      :orientation "h"
      :space-evenly false
      (label 
        :text "${wifi_enabled == 'enabled' ?
          wifi_connected == 'yes' ?
          wifi_strength >= 75 ? '󰤨' :
          wifi_strength >= 50 ? '󰤥' :
          wifi_strength >= 25 ? '󰤢' : '󰤟'
        :
          '󰤯'
        : 
          '󰤭'
        }"
      )
      (label
        :class "network-title"
        :text wifi_ssid_label
      )
    )
  )
)

;; Popup widget with network details and controls
(defwidget network_popup []
  (connection_panel
    :enabled "${wifi_enabled == 'enabled'}"
    :toggle_onclick "nmcli radio wifi ${wifi_enabled == 'enabled' ? 'off' : 'on'}"
    :list_label "Available Networks"
    :list wifi_networks
    :list_height 200
    :disabled_text "WiFi is disabled"
    :locked "${wifi_prompt != ''}"
    (box
      :visible "${wifi_enabled == 'enabled' && wifi_connected == 'yes'}"
      (connection_current
        :onclick "~/.config/eww/scripts/wifi-action.sh disconnect"
        :icon ""
        :name wifi_ssid
        :detail "${wifi_strength}%"
        :pending "${wifi_pending == 'current'}"
        :locked "${wifi_prompt != ''}"
      )
    )
    (connection_empty
      :text "Not connected to any network"
      :visible "${wifi_enabled == 'enabled' && wifi_connected == 'no'}"
    )
  )
)

;; Popup window definition; reopens use the no-animation namespace (hyprland.lua layer rule)
(defwindow network-window [focus animate]
  :geometry (geometry
    :x "5px"
    :y "5px"
    :width "300px"
    :anchor "top right"
  )
  :stacking "overlay"
  :exclusive false
  :focusable focus
  :namespace "${animate ? 'eww-network' : 'eww-network-instant'}"
  (network_popup)
)
