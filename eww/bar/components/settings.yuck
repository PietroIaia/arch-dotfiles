(include "./bar/components/network.yuck")
(include "./bar/components/volume.yuck")
(include "./bar/components/battery.yuck")
(include "./bar/components/clock.yuck")
(include "./bar/components/power.yuck")

;; Settings widget
(defwidget settings [monitor]
  (box
    :orientation "h"
    :space-evenly false
    :halign "end"
    (volume_button :monitor monitor)
    (battery)
    (wifi_button :monitor monitor)
    (clock)
    (power_button :monitor monitor)
  )
)

