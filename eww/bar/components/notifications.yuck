;; Single notification card. `n` is the parsed JSON object pushed into a slot var.
(defwidget notification_card [n]
  (box
    :class "notification-card ${n.urgency}"
    :orientation "h"
    :space-evenly false
    (image
      :class "notification-icon"
      :path "${n.icon}"
      :image-width 48
      :image-height 48
      :visible "${n.icon != ''}"
    )
    (box
      :orientation "v"
      :space-evenly false
      :hexpand true
      (box
        :orientation "h"
        :space-evenly false
        (label
          :class "notification-app"
          :text "${n.app_name}"
          :halign "start"
          :hexpand true
          :truncate true
        )
        (button
          :class "notification-dismiss"
          :onclick "~/.config/eww/scripts/notification-dismiss.sh ${n.id}"
          (label :text "✓")
        )
      )
      (label
        :class "notification-title"
        :text "${n.summary}"
        :xalign 0
        :hexpand true
      )
      (label
        :class "notification-body"
        :text "${n.body}"
        :xalign 0
        :hexpand true
        :visible "${n.body != ''}"
      )
    )
  )
)
