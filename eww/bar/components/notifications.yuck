;; Single notification card
(defwidget notification_card [n]
  (box
    :class "notification-card ${n.urgency}"
    :orientation "h"
    :space-evenly false
    (image
      :class "notification-icon"
      :path "${n.icon}"
      :image-width 48
      :image-height 48
      :visible "${n.icon != ''}"
    )
    (box
      :orientation "v"
      :space-evenly false
      :hexpand true
      (box
        :orientation "h"
        :space-evenly false
        (label
          :class "notification-app"
          :text "${n.app_name}"
          :halign "start"
          :hexpand true
          :truncate true
        )
        (button
          :class "notification-dismiss"
          :onclick "~/.config/eww/scripts/notification-dismiss.sh ${n.id}"
          (label :text "✓")
        )
      )
      (label
        :class "notification-title"
        :text "${n.summary}"
        :halign "start"
        :wrap true
      )
      (label
        :class "notification-body"
        :text "${n.body}"
        :halign "start"
        :wrap true
        :visible "${n.body != ''}"
      )
    )
  )
)

;; Notification stack — pushes cards below the bar and any open popup
(defwidget notification_stack []
  (box
    :class "notification-stack"
    :orientation "v"
    :valign "start"
    :space-evenly false
    :style "margin-top: ${popup_open == 'calendar-window' ? '400' : popup_open == 'network-window' ? '350' : popup_open == 'volume-window' ? '100' : '0'}px;"
    (for n in notifications
      (notification_card :n n))
  )
)
