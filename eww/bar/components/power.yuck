;; Power Management Widget
;; Provides shutdown, reboot, sleep, and logout options

;; Main power button widget that appears in the settings bar
(defwidget power_button [monitor]
  (button
    :class "widget power"
    :onclick "~/.config/eww/scripts/toggle-popup.sh power-window ${monitor}"
    (label
      :text "⏻"
    )
  )
)

;; Power overlay widget with power options
(defwidget power_overlay []
  (box
    :class "power-overlay"
    :orientation "v"
    :space-evenly false
    (box
      :class "power-options"
      :orientation "v"
      :space-evenly false
      (box
        :class "power-row"
        :orientation "h"
        :space-evenly true
        (button
          :class "power-option"
          :onclick "~/.config/eww/scripts/close-popup.sh && systemctl poweroff"
          (box
            :orientation "v"
            :space-evenly false
            (label :class "power-icon" :text "⏻")
            (label :class "power-label" :text "Shutdown")
          )
        )
        (button
          :class "power-option"
          :onclick "~/.config/eww/scripts/close-popup.sh && systemctl reboot"
          (box
            :orientation "v"
            :space-evenly false
            (label :class "power-icon" :text "↻")
            (label :class "power-label" :text "Reboot")
          )
        )
      )
      (box
        :class "power-row"
        :orientation "h"
        :space-evenly true

        (button
          :class "power-option"
          :onclick "~/.config/eww/scripts/close-popup.sh && systemctl suspend"
          (box
            :orientation "v"
            :space-evenly false
            (label :class "power-icon" :text "⏾")
            (label :class "power-label" :text "Sleep")
          )
        )
        (button
          :class "power-option"
          :onclick "~/.config/eww/scripts/close-popup.sh && hyprctl dispatch exit"
          (box
            :orientation "v"
            :space-evenly false
            (label :class "power-icon" :text "⎋")
            (label :class "power-label" :text "Logout")
          )
        )
      )
    )
  )
)

;; Overlay window definition
(defwindow power-window
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "20%"
    :height "10%"
    :anchor "center"
  )
  :stacking "overlay"
  :exclusive false
  :focusable false
  (power_overlay)
)
