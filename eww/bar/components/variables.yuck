;; Popup state
(defvar popup_open "none")

;; Notification slots — each holds one notification (JSON object) or "{}" when empty.
;; Geometry per slot is set by the daemon at open time via `eww open --pos --size`,
;; so the placeholder geometry in the defwindow is overridden every time.
(defvar slot_0 "{}")
(defvar slot_1 "{}")
(defvar slot_2 "{}")
(defvar slot_3 "{}")
(defvar slot_4 "{}")

;; Calendar popup state. Like cal_month/cal_year, cal_grid is event-driven, not
;; polled: cal-nav.sh rewrites all three on nav, and toggle-popup.sh runs
;; `cal-nav.sh reset` before opening the popup, so they are always current by
;; the time the window renders. Polling the grid meant the daemon spawning a
;; script that queried the daemon twice a second, forever, even while closed.
(defvar cal_month 4)
(defvar cal_year 2026)
(defvar cal_grid "(box)")

;; Workspace variables (event-driven via Hyprland socket2 — no polling lag)
(deflisten monitor0_workspace "~/.config/eww/scripts/hypr-monitor-ws.sh 0")
(deflisten monitor1_workspace "~/.config/eww/scripts/hypr-monitor-ws.sh 1")
(defpoll primary_bar_monitor :interval "1s" "hyprctl monitors -j | jq '(to_entries | .[] | select(.value.name == \"HDMI-A-1\") | .key) // (to_entries | .[] | select(.value.name == \"eDP-1\") | .key)'")
(defpoll secondary_bar_monitor :interval "1s" "hyprctl monitors -j | jq 'if (map(.name) | contains([\"HDMI-A-1\"])) then (to_entries | .[] | select(.value.name == \"eDP-1\") | .key) else -1 end'")
;; Volume variables
(defpoll volume :interval "100ms" "pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\\d+%' | head -1 | tr -d '%'")
(defpoll volume_muted :interval "100ms" "pactl get-sink-mute @DEFAULT_SINK@ | grep -q 'yes' && echo 'true' || echo 'false'")
;; Battery variables
(defpoll battery_percent :interval "5s" "cat /sys/class/power_supply/BAT0/capacity")
(defpoll battery_status :interval "1s" "cat /sys/class/power_supply/BAT0/status")
(defpoll battery_charging_frame :interval "500ms" "echo $(( ($(date +%s) / 1) % 5 ))")
(defpoll power_profile :interval "2s" "cat /sys/firmware/acpi/platform_profile")
;; Network/WiFi variables
(defpoll wifi_enabled :interval "2s" "nmcli radio wifi")
(defpoll wifi_connected :interval "2s" "nmcli -t -f DEVICE,TYPE,STATE device | grep -q 'wifi:connected' && echo 'yes' || echo 'no'")
(defpoll wifi_ssid :interval "2s" "nmcli -t -f active,ssid device wifi | grep '^yes' | cut -d':' -f2")
(defpoll wifi_strength :interval "2s" "nmcli -t -f active,signal device wifi | grep '^yes' | cut -d':' -f2")
(defpoll wifi_networks :interval "10s" "~/.config/eww/scripts/wifi-networks.sh")
