(include "./bar/components/variables.yuck")
(include "./bar/components/bar.yuck")

;; Calendar popup window
(defwindow calendar-popup
  :geometry (geometry
    :x "5px"
    :y "5px"
    :width "320px"
    :anchor "top right"
  )
  :stacking "overlay"
  :exclusive false
  :focusable false
  (calendar_popup)
)

;; Click-catchers: one per monitor, positioned below the bar so bar buttons remain clickable.
;; Both open whenever a popup opens; clicking either closes the active popup.
(defwindow click-catcher-0
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "100%"
    :height "95%"
    :anchor "top center"
  )
  :stacking "fg"
  :exclusive false
  :focusable false
  (eventbox
    :onclick "~/.config/eww/scripts/close-popup.sh"
    (box :hexpand true :vexpand true)
  )
)

(defwindow click-catcher-1
  :geometry (geometry
    :x "0%"
    :y "0%"
    :width "100%"
    :height "95%"
    :anchor "top center"
  )
  :stacking "fg"
  :exclusive false
  :focusable false
  (eventbox
    :onclick "~/.config/eww/scripts/close-popup.sh"
    (box :hexpand true :vexpand true)
  )
)

;; Window definition for monitor 0 (workspaces 1-5)
(defwindow primary-bar
  :geometry (geometry
    :x "0%"
    :y "5"
    :width "100%"
    :height "2%"
    :anchor "top center"
  )
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :ws_start 1 :monitor primary_bar_monitor)
)

;; Window definition for monitor 1 (workspaces 6-10)
(defwindow secondary-bar
  :geometry (geometry
    :x "0%"
    :y "5"
    :width "100%"
    :height "2%"
    :anchor "top center"
  )
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :ws_start 6 :monitor secondary_bar_monitor)
)

