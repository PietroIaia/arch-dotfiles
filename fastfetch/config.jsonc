{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/pictures/random.png",
        "width": 31,
        "height": 12,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 1
        }
    },
    "display": {
        "separator": ">  ",
        "color": {
            "separator": "red"
        },
        "constants": [
            "──────────────────────────────────────────────────",
            "│\u001b[50C│\u001b[50D"
        ]
    },
    "modules": [
        {
            "format": "{#1}{#keys}╭{$1}╮\u001b[51D {user-name-colored}{at-symbol-colored}{host-name-colored} ",
            "type": "title"
        },
        {
            "key": "{$2}{#31} kernel   ",
            "type": "kernel"
        },
        {
            "key": "{$2}{#32}󰅐 uptime   ",
            "type": "uptime"
        },
        {
            "key": "{$2}{#33}{icon} distro   ",
            "type": "os"
        },
        {
            "key": "{$2}{#36} shell    ",
            "type": "shell"
        },
        {
            "key": "{$2}{#31}󰩟 network  ",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "format": "{#1}{#keys}├{$1}┤\u001b[50D Hardware ",
            "type": "custom"
        },
        {
            "key": "{$2}{#35}󰍛 cpu      ",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "{$2}{#34}󰍛 gpu      ",
            "type": "command",
            "text": "nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null"
        },
        {
            "key": "{$2}{#32} memory   ",
            "type": "memory"
        },
        {
            "format": "{#1}{#keys}├{$1}┤\u001b[50D Disks ",
            "type": "custom"
        },
        {
            "key": "{$2}{#33}󰉉 root     ",
            "type": "disk",
            "format": "{size-used} / {size-total} ({size-percentage})",
            "folders": "/"
        },
        {
            "key": "{$2}{#33}󰉉 home     ",
            "type": "disk",
            "format": "{size-used} / {size-total} ({size-percentage})",
            "folders": "/home"
        },
        {
            "format": "{#1}{#keys}├{$1}┤\u001b[50D Diagnostics ",
            "type": "custom"
        },
        {
            "key": "{$2}{#35}󰍛 cpu      ",
            "type": "cpuusage",
            "format": "Avg: {avg} | Max: {max} | Min: {min}"
        },
        {
            "key": "{$2}{#34}└─ temp    ",
            "type": "cpu",
            "temp": true,
            "format": "{temperature}"
        },
        {
            "format": "{#1}{#keys}╰{$1}╯",
            "type": "custom"
        }
    ]
}
