{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "source": "~/.config/fastfetch/pictures/random.png",
        "padding": {
            "top": 1,
            "left": 1,
            "right": 1,
        }
    },
    "display": {
        "separator": ">  ",
        "color": {
            "separator": "red"
        },
        "constants": [
            "───────────────────────────────────────────────────────────────────────────",
            "│\u001b[75C│\u001b[75D"
        ]
    },
    "modules": [
        {
            "format": "{#1}{#keys}╭{$1}╮\u001b[76D {user-name-colored}{at-symbol-colored}{host-name-colored} ",
            "type": "title"
        },
        {
            "key": "{$2}{#31} kernel   ",
            "type": "kernel"
        },
        {
            "key": "{$2}{#32}󰅐 uptime   ",
            "type": "uptime"
        },
        {
            "key": "{$2}{#33}{icon} distro   ",
            "type": "os"
        },
        {
            "key": "{$2}{#36} shell    ",
            "type": "shell"
        },
        {
            "key": "{$2}{#34}󰍛 gpu      ",
            "type": "gpu"
        },
        {
            "key": "{$2}{#35}󰍛 cpu      ",
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        {
            "format": "{#1}{#keys}├{$1}┤ \u001b[76D Disk Usage ",
            "type": "custom"
        },
        {
            "key": "{$2}{#33}󰉉 root     ",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "{$2}{#33}󰉉 home     ",
            "type": "disk",
            "folders": "/home"
        },
        {
            "format": "{#1}{#keys}├{$1}┤ \u001b[76D Diagnostics ",
            "type": "custom"
        },
        {
            "key": "{$2}{#35}󰍛 cpu usage",
            "type": "cpuusage",
            "format": "Avg: {avg} | Max: {max} (Core {max-index}) | Min: {min} (Core {min-index})"
        },
        {
            "key": "{$2}{#32} memory   ",
            "type": "memory"
        },
        {
            "key": "{$2}{#31}󰩟 network  ",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "format": "{#1}{#keys}├{$1}┤",
            "type": "custom"
        },
        {
            "format": "{#1}{#keys}╰{$1}╯",
            "type": "custom"
        }
    ]
}
